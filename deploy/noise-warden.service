[Unit]
Description=Noise Warden
After=network-online.target sound.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/noise-warden
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/pi/noise-warden/.venv/bin/python -m app.main
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
